# PostgreSQL
DATABASE_URL="postgresql://alirezarashvand:YOUR_PASSWORD@localhost:5432/younes_store"

# Auth / sessions
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
ROOT_ADMIN_PHONE="09123456789"

# OTP: development | production
# development enables fixed OTP 123456 (never use in production)
OTP_MODE="development"

# Public site URL (used for SEO canonical URLs / sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# S3-compatible object storage
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_BUCKET="younes-store"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="true"
